{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/biblioteca",
      "destination": "/biblioteca/acervo",
      "permanent": false
    },
    {
      "source": "/es/biblioteca",
      "destination": "/es/biblioteca/acervo",
      "permanent": false
    },
    {
      "source": "/en/biblioteca",
      "destination": "/en/biblioteca/acervo",
      "permanent": false
    },
    {
      "source": "/quemsomos",
      "destination": "/quem-somos",
      "permanent": true
    },
    {
      "source": "/termo_de_uso",
      "destination": "/termos",
      "permanent": true
    },
    {
      "source": "/politica_de_privacidade",
      "destination": "/privacidade",
      "permanent": true
    },
    {
      "source": "/livro/sistemas-taticos",
      "destination": "/livros/sistemas-taticos",
      "permanent": true
    },
    {
      "source": "/livro/situacoes-taticas-de-jogo-fase-ofensiva",
      "destination": "/livros/situacoes-taticas-de-jogo-fase-ofensiva",
      "permanent": true
    },
    {
      "source": "/livro/:slug",
      "destination": "/livros/:slug",
      "permanent": true
    },
    {
      "source": "/acervo",
      "destination": "/biblioteca/acervo",
      "permanent": false
    },
    {
      "source": "/biblioteca-eoj",
      "destination": "/biblioteca/acervo",
      "permanent": false
    },
    {
      "source": "/curso/:slug",
      "destination": "/cursos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/img/:path*",
      "destination": "https://nextjs-murex-two-93.vercel.app/img/:path*"
    }
  ]
}